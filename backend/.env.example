# ── AI meal recommendations ──────────────────────────────────────────────────
# Provider: "ollama" (free, local — default) or "anthropic" (paid API).
# Leaving this blank picks "anthropic" only if ANTHROPIC_API_KEY is set below,
# otherwise "ollama".
AI_PROVIDER=ollama

# Ollama — install from https://ollama.com, then: ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic — only if you set AI_PROVIDER=anthropic. Key from
# https://console.anthropic.com/ (billed separately from a Claude.ai subscription).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Auth ─────────────────────────────────────────────────────────────────────
# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# ── Google (Sign-in with Google + Google Calendar workout import) ─────────────
# Create an OAuth 2.0 Client (type: Web) at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must match GOOGLE_REDIRECT_URI below.
# Scopes: openid, email, profile, https://www.googleapis.com/auth/calendar.events.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google

# ── Optional ─────────────────────────────────────────────────────────────────
# Google Geocoding key — only used to place restaurants that aren't in the
# built-in Skopje coordinate list. The app works fine without it.
GOOGLE_PLACES_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
PORT=3001
# Public origin of the frontend (for CORS + OAuth redirects)
FRONTEND_ORIGIN=http://localhost:3000
